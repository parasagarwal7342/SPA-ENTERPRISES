# ---- Required in production ----
NODE_ENV=production
# Long random string used to sign login tokens (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=
# The owner account is created/updated from these on every start.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=SPA Owner
# Where the SQLite database and uploads live. On Railway, attach a Volume and mount it here.
DATA_DIR=/data
# Website origins allowed to call this API (comma separated).
CORS_ORIGINS=https://spaenterprise.in,https://www.spaenterprise.in
SITE_URL=https://spaenterprise.in

# ---- Payments ----
# Razorpay dashboard -> Settings -> API Keys. Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard -> Settings -> Webhooks: URL https://<api-domain>/api/payment/webhook,
# events payment.captured + order.paid, and the same secret here.
RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=true

# ---- Shipping (rupees) ----
SHIPPING_FEE_DELHI=0
SHIPPING_FEE_INDIA=500
FREE_SHIPPING_ABOVE=4999
SHIPPING_FEE_GLOBAL=2500
LOW_STOCK_THRESHOLD=5

# ---- Contact & alerts ----
WHATSAPP_NUMBER=919312277087
# Optional Slack/Discord incoming-webhook URL: instant alert for every new order and lead.
NOTIFY_WEBHOOK_URL=

# ---- AI (optional) ----
# Powers the website shopping assistant and the social post generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=

# ---- Social auto-posting (optional) ----
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://your-backend.railway.app/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
